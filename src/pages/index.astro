---
import { filtros, modelos } from "../data/modelos";
import SiteHeader from "../components/SiteHeader.astro";
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>BCN Muse | Modelos en Barcelona</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=PT+Sans:ital,wght@0,400;0,700;1,400;1,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <SiteHeader />

<main class="hero">
  <h1>Agencia de acompañantes VIP de Barcelona</h1>
  <p>BCN Muse es una agencia de escorts de lujo en Barcelona, representando y eligiendo a las mejores acompañantes para compartir una experiencia personal única. Elegimos a nuestras modelos con una rigurosa selección.</p>
  <a href="#modelos" class="gold-button">Ver Modelos</a>
</main>

<!-- CONTENEDOR PRINCIPAL (Grid con barra lateral) -->
<div class="layout-container" id="modelos">
  
  <!-- Columna Izquierda: Catálogo de Modelos -->
  <main class="main-content">
    <div class="page-header">
      <h2 class="large-text">Nuestras Modelos</h2>
      <p>Explora nuestra exclusiva selección de acompañantes.</p>
    </div>

    <div class="models-grid">
      {modelos.map((modelo) => (
        <a href={`/modelos/${modelo.slug}`} class="model-card">
          <div class="image-wrapper">
            <img
              src={modelo.fotoPortada}
              alt={modelo.nombre}
              style={`object-position: center ${modelo.posicionPortada};`}
            />
            {modelo.disponible && (
              <div class="status-badge">
                <div class="status-dot"></div>
                <span class="status-text">Disponible</span>
              </div>
            )}
          </div>
          <div class="model-info">
            <h3>{modelo.nombre}</h3>
            <p>{modelo.edad} años | {modelo.nacionalidad}</p>
          </div>
        </a>
      ))}
    </div>
  </main>

  <!-- Columna Derecha: Barra Lateral con Filtros -->
  <aside class="sidebar">
    <div class="filter-box">
      <div class="filter-grid">
        {filtros.map((filtro) => (
          <a href={`/filtros/${filtro.slug}`}>{filtro.nombre}</a>
        ))}
      </div>
    </div>

    <div class="sidebar-text">
      <p><strong>Nuevas incorporaciones:</strong> Descubre a nuestras últimas modelos llegadas a Barcelona.</p>
      <p><strong>Experiencias VIP:</strong> Reserva con antelación para asegurar la disponibilidad de nuestras mejores acompañantes.</p>
    </div>
  </aside>

</div>

<section class="home-contact" id="contacto" aria-label="Contacta con BCN Muse">
  <p>Contacta con nosotros</p>
  <div class="home-contact-options">
    <a class="contact-whatsapp" href="https://wa.me/34652818228" target="_blank" rel="noreferrer" aria-label="Contacta por WhatsApp">
      <svg class="whatsapp-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.6 0 .3 5.3.3 11.8c0 2.1.6 4.2 1.6 6L0 24l6.3-1.7a11.8 11.8 0 0 0 5.8 1.5h.1c6.5 0 11.8-5.3 11.8-11.8 0-3.2-1.2-6.2-3.5-8.5ZM12.1 21.8a9.9 9.9 0 0 1-5-1.4l-.4-.2-3.7 1 1-3.6-.3-.4a9.9 9.9 0 1 1 8.4 4.6Zm5.5-7.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.2-.2.3-.7.9-.9 1.1-.2.2-.3.2-.6.1-.3-.1-1.2-.5-2.3-1.4-.9-.8-1.5-1.7-1.7-2-.2-.3 0-.4.1-.6l.5-.5.3-.5c.1-.2 0-.4 0-.5 0-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4s-1 1-1 2.4 1 2.8 1.2 3c.1.2 2 3.1 4.9 4.4.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.6-.1 1.7-.7 2-1.3.2-.6.2-1.1.2-1.3-.1-.2-.3-.3-.6-.4Z" />
      </svg>
      <span>Escríbenos por WhatsApp</span>
    </a>
    <a class="contact-telegram" href="https://t.me/+34652818228" target="_blank" rel="noreferrer" aria-label="Contacta por Telegram">
      <svg class="telegram-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M22.4 1.6 1.5 9.7c-1.4.6-1.4 1.4-.3 1.7l5.3 1.7 2 6.2c.2.7.1 1 .8 1 .5 0 .8-.2 1.1-.5l2.6-2.5 5.4 4c1 .6 1.7.3 1.9-.9l3.5-16.5c.3-1.5-.6-2.1-1.4-1.8ZM8 12.7l11-6.9c.5-.3.9-.1.6.2l-9.1 8.2-.4 4.3L8 12.7Z" />
      </svg>
      <span>Escríbenos por Telegram</span>
    </a>
  </div>
</section>

<!-- Sección Trabaja con Nosotros -->
<section class="reclutamiento" id="agencia">
  <div class="container">
    <div class="reclutamiento-header">
      <h2 class="large-text">Trabaja como Escort de Lujo en Barcelona</h2>
      <p>Únete a la agencia de escorts de lujo más exclusiva de Barcelona. Discreción, elegancia y profesionalismo.</p>
      <a href="#contacto" class="gold-button">Quiero ser modelo de BCN Muse</a>
    </div>
  </div>
</section>

<style is:global>
  /* Fondo base: Un negro carbón muy profundo, más elegante que el gris plano */
  html, body {
    margin: 0;
    padding: 0;
    font-family: 'PT Sans', sans-serif; 
    background-color: #0a0a0a !important; /* Negro azabache */
    color: #e0e0e0 !important; /* Blanco roto, no cansa la vista */
    min-height: 100vh;
  }

  a { text-decoration: none; }

  /* CABECERA: Fondo casi negro con línea dorada fina */
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 5%; /* Más margen a los lados */
    background-color: rgba(10, 10, 10, 0.95); /* Efecto cristal */
    backdrop-filter: blur(10px);
    color: #fff;
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid rgba(212, 175, 55, 0.3); /* Línea dorada sutil */
  }

  /* PORTADA (HERO): Tipografía imponente y texto contenido */
  .hero {
    height: 80vh; /* Más alto para que impacte */
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    background-image: linear-gradient(rgba(10,10,10,0.6), rgba(10,10,10,0.9)), url('/modelos/Meghan/Meghan.webp');
    background-size: cover;
    background-position: center 20%;
    padding: 0 2rem;
  }

  .hero h1 {
    width: 100%;
    max-width: 1000px;
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    margin-bottom: 1.5rem; 
    font-family: 'Playfair Display', serif;
    line-height: 1.1;
    text-wrap: balance;
    text-shadow: 2px 2px 10px rgba(0,0,0,0.5);
  }

  /* AQUÍ ARREGLAMOS EL TEXTO DE PUNTA A PUNTA */
  .hero p { 
    font-size: 1.2rem; 
    margin-bottom: 3rem; 
    max-width: 700px; /* Limita el ancho del texto para que respire */
    line-height: 1.6;
    color: #ccc;
  }

  /* BOTÓN DORADO PREMIUM */
  .gold-button {
    display: inline-block;
    background-color: transparent; /* Fondo transparente */
    color: #d4af37;
    border: 1px solid #d4af37;
    padding: 16px 45px;
    font-size: 15px;
    font-weight: bold;
    cursor: pointer;
    border-radius: 0px; /* Sin bordes redondeados = más serio */
    text-transform: uppercase;
    letter-spacing: 2px;
    transition: all 0.4s ease;
  }

  .gold-button:hover { 
    background-color: #d4af37; 
    color: #000;
  }

  /* LAYOUT PRINCIPAL */
  .layout-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    max-width: 1400px;
    margin: 0 auto;
    padding: 5rem 2rem;
  }

  @media (min-width: 992px) {
    .layout-container { grid-template-columns: 3.5fr 1.5fr; }
  }

  /* CABECERA DE SECCIÓN */
  .page-header {
    margin-bottom: 3rem;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    padding-bottom: 1.5rem;
  }

  .large-text { 
    font-size: 2.8rem; 
    color: #fff; /* Blanco para el título principal */
    margin-bottom: 0.5rem; 
    margin-top: 0; 
    font-family: 'Playfair Display', serif;
  }
  
  /* Un toque dorado solo en una palabra si quieres, o en el subtítulo */
  .page-header p { 
    color: #888; 
    margin: 0; 
    font-size: 1.1rem;
    letter-spacing: 1px;
  }

  /* TARJETAS DE MODELOS */
  .models-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem; /* Más espacio entre tarjetas */
  }

  @media (min-width: 1200px) {
    .models-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .model-card {
    display: block;
    position: relative;
    overflow: hidden;
    background-color: #121212; /* Fondo tarjeta muy oscuro */
    border: 1px solid rgba(255,255,255,0.05); /* Borde sutil */
    border-radius: 0px; /* Cuadrado */
  }

  .model-card .image-wrapper {
    position: relative;
    height: 450px; /* Fotos más altas, tipo retrato editorial */
  }

  .model-card img {
    width: 100%;
    height: 100%;
    object-fit: cover; 
    transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94); /* Zoom más suave y lento */
    filter: brightness(0.9);
  }

  .model-card:hover img {
    transform: scale(1.08);
    filter: brightness(1.1); /* Ilumina la foto al pasar el ratón */
  }

  /* INFORMACIÓN SOBRE LA FOTO */
  .model-info {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0) 100%);
    padding: 4rem 1rem 1.5rem 1rem;
    box-sizing: border-box;
    text-align: center;
  }

  .model-info h3 {
    margin: 0;
    font-size: 1.6rem;
    color: #fff;
    letter-spacing: 3px;
    font-family: 'Playfair Display', serif;
    text-transform: uppercase;
  }

  .model-info p {
    margin: 5px 0 0 0;
    font-size: 0.85rem;
    color: #d4af37; /* Solo el dato en dorado */
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  /* ETIQUETA DISPONIBLE (Más sutil, elegante) */
  .status-badge {
    position: absolute;
    top: 20px;
    right: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
    background-color: rgba(10, 10, 10, 0.8);
    padding: 6px 14px;
    border-radius: 20px;
    border: 1px solid #27ae60;
    backdrop-filter: blur(5px);
    z-index: 10;
    animation: parpadeo-borde 2s infinite;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    background-color: #27ae60; /* Verde esmeralda, más serio */
    border-radius: 50%;
    box-shadow: 0 0 10px #27ae60;
    animation: parpadeo 2s infinite; /* Parpadeo más lento */
  }

  .status-text {
    color: #fff; /* Texto blanco */
    font-family: 'PT Sans', sans-serif;
    font-size: 0.7rem;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }

  @keyframes parpadeo {
    0% { opacity: 1; }
    50% { opacity: 0.4; }
    100% { opacity: 1; }
  }

  @keyframes parpadeo-borde {
    0%, 100% {
      border-color: #27ae60;
      box-shadow: 0 0 8px rgba(39, 174, 96, 0.35);
    }
    50% {
      border-color: rgba(39, 174, 96, 0.25);
      box-shadow: 0 0 2px rgba(39, 174, 96, 0.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-badge,
    .status-dot {
      animation: none;
    }
  }

  /* BARRA LATERAL (FILTROS) */
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .filter-box {
    background-color: #121212;
    border: 1px solid #d4af37;
    border-radius: 14px;
    padding: 2rem;
  }

  .filter-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    text-align: center;
  }

  .filter-grid a {
    color: #999;
    font-size: 0.9rem;
    letter-spacing: 1px;
    transition: color 0.3s;
  }

  .filter-grid a:hover { color: #d4af37; }

  .sidebar-text {
    font-size: 0.95rem;
    color: #777;
    line-height: 1.8;
    letter-spacing: 0.5px;
  }
  .sidebar-text strong { color: #aaa; }

  .home-contact {
    max-width: 760px;
    margin: 0 auto 4rem;
    padding: 1.4rem 1.6rem;
    border: 1px solid #d4af37;
    border-radius: 14px;
  }

  .home-contact > p {
    margin: 0 0 0.8rem;
    color: #d4af37;
    text-align: center;
    font-size: 0.95rem;
    letter-spacing: 0.05em;
  }

  .home-contact-options {
    display: flex;
    justify-content: center;
    gap: 2rem;
  }

  .home-contact-options a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 1rem;
    color: #fff;
    border: 1px solid;
    border-radius: 9px;
    transition: background-color 0.2s;
  }

  .home-contact-options svg {
    width: 22px;
    height: 22px;
  }

  .home-contact-options .whatsapp-icon {
    fill: #25d366;
  }

  .home-contact-options .contact-whatsapp {
    background: rgba(37, 211, 102, 0.12);
    border-color: #25d366;
  }

  .home-contact-options .contact-whatsapp:hover {
    background: rgba(37, 211, 102, 0.25);
  }

  .home-contact-options .telegram-icon {
    fill: #229ed9;
  }

  .home-contact-options .contact-telegram {
    background: rgba(34, 158, 217, 0.12);
    border-color: #229ed9;
  }

  .home-contact-options .contact-telegram:hover {
    background: rgba(34, 158, 217, 0.25);
  }

  /* SECCIÓN TRABAJA CON NOSOTROS */
  .reclutamiento {
    padding: 6rem 2rem;
    background-color: #050505; /* Negro absoluto */
    text-align: center;
    border-top: 1px solid rgba(255,255,255,0.05);
  }
  
  .reclutamiento-header p {
    color: #888;
    margin-bottom: 2.5rem;
    font-size: 1.1rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  /* DISEÑO PARA MÓVILES */
  @media (max-width: 768px) {
    .hero { height: 70vh; padding: 0 1.5rem; }
    .hero h1 { font-size: 2.8rem; }
    .hero p { font-size: 1rem; }
    
    .layout-container { padding: 3rem 1rem; gap: 3rem; }

    .home-contact {
      width: calc(100% - 2rem);
      margin-bottom: 3rem;
      padding: 1.2rem;
    }

    .home-contact-options {
      flex-direction: column;
      align-items: center;
      gap: 0.8rem;
    }
    
    /* AQUÍ ESTÁ EL CAMBIO A 2 COLUMNAS */
    .models-grid { 
      grid-template-columns: repeat(2, 1fr); /* Crea 2 columnas */
      gap: 10px; /* Reduce el espacio entre ellas */
    } 
    
    /* Ajustamos la altura de las fotos para que no sean tan largas */
    .model-card .image-wrapper { 
      height: 260px; /* Altura reducida para pantallas de móvil */
    }

    /* Hacemos la letra un poco más pequeña para que quepa bien en el hueco */
    .model-info {
      padding: 2rem 0.5rem 1rem 0.5rem;
    }
    .model-info h3 { 
      font-size: 1.1rem; 
      letter-spacing: 1px;
    }
    .model-info p { 
      font-size: 0.7rem; 
    }

    /* Hacemos la etiqueta de "Disponible" más pequeña */
    .status-badge {
      top: 10px;
      right: 10px;
      padding: 4px 8px;
      gap: 4px;
    }
    .status-text {
      font-size: 0.55rem;
    }
    .status-dot {
      width: 6px;
      height: 6px;
    }
  }
</style>
  </body>
</html>