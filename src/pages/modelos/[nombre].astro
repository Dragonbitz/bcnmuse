---
import { modelos } from "../../data/modelos";
import SiteHeader from "../../components/SiteHeader.astro";

export function getStaticPaths() {
  return modelos.map((modelo) => ({
    params: { nombre: modelo.slug },
    props: { modelo },
  }));
}

const { modelo } = Astro.props;
const telefono = "+34652818228";
const telefonoLimpio = telefono.replace("+", "");
const caracteristicas = [
  { nombre: "Edad", valor: `${modelo.edad} años` },
  { nombre: "Nacionalidad", valor: modelo.nacionalidad },
  { nombre: "Pelo", valor: modelo.pelo },
  { nombre: "Peso", valor: modelo.peso },
  { nombre: "Altura", valor: modelo.altura },
  { nombre: "Pecho", valor: modelo.pecho },
  { nombre: "Medidas", valor: modelo.medidas },
  { nombre: "Idiomas", valor: modelo.idiomas },
];
const servicios = [
  "Compañía",
  "Parejas",
  "Dúplex",
  "Facesitting",
  "Francés",
  "Lluvia dorada",
  "Salidas a hotel",
  "Striptease",
  "Lésbico",
  "Orgías",
  "Tríos",
  "Despedidas",
  "Garganta profunda",
  "Masajes eróticos",
  "Fantasías sexuales",
  "Fetiches",
  "Girlfriend experience",
  "Salidas a domicilio",
  "Besos",
  "Cunnilingus",
  "Cubana",
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`Portfolio de ${modelo.nombre} en BCN Muse.`} />
    <title>{modelo.nombre} | BCN Muse</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=PT+Sans:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <SiteHeader />

    <main class="profile">
      <div class="profile-heading">
        <p class="eyebrow">Portfolio exclusivo</p>
        <h1>{modelo.nombre}</h1>
        {modelo.disponible && (
          <p class="availability"><span class="availability-dot"></span>Disponible</p>
        )}
        <p class="subtitle">{modelo.edad} años <span aria-hidden="true">·</span> {modelo.nacionalidad}</p>
      </div>

      <section class="portfolio-grid" aria-label={`Galería de ${modelo.nombre}`}>
        {modelo.imagenes.map((imagen, indice) => (
          <button
            class:list={["portfolio-photo", { "portfolio-photo-featured": indice === 0 }]}
            type="button"
            data-gallery-index={indice}
            aria-label={`Ampliar foto ${indice + 1} de ${modelo.nombre}`}
          >
            <img
              src={imagen}
              alt={`${modelo.nombre}, foto ${indice + 1}`}
              loading={indice === 0 ? "eager" : "lazy"}
            />
          </button>
        ))}
      </section>

      <dialog class="lightbox" id="lightbox" aria-label={`Galería de fotos de ${modelo.nombre}`}>
        <button class="lightbox-close" type="button" aria-label="Cerrar foto ampliada">&times;</button>
        <button class="lightbox-nav lightbox-previous" type="button" aria-label="Foto anterior">
          <span aria-hidden="true">&lsaquo;</span>
        </button>
        <figure class="lightbox-content">
          <img class="lightbox-image" id="lightbox-image" alt="" />
          <figcaption class="lightbox-counter" id="lightbox-counter"></figcaption>
        </figure>
        <button class="lightbox-nav lightbox-next" type="button" aria-label="Foto siguiente">
          <span aria-hidden="true">&rsaquo;</span>
        </button>
      </dialog>

      <div class="details-layout">
        <section class="details-card" aria-labelledby="details-title">
          {modelo.descripcion && (
            <div class="model-description">
              <p class="eyebrow">Conócela</p>
              <p>{modelo.descripcion}</p>
            </div>
          )}

          <section aria-labelledby="details-title">
            <p class="eyebrow">Perfil</p>
            <h2 id="details-title">Características</h2>
            <dl>
              {caracteristicas.map((caracteristica) => (
                <div>
                  <dt>{caracteristica.nombre}</dt>
                  <dd>{caracteristica.valor}</dd>
                </div>
              ))}
            </dl>
          </section>

          <section class="services-section" aria-labelledby="services-title">
            <p class="eyebrow">Experiencias</p>
            <h2 id="services-title">Servicios</h2>
            <ul class="service-list">
              {servicios.map((servicio) => <li>{servicio}</li>)}
            </ul>
          </section>
        </section>

        <aside class="contact-card" aria-label="Contactar">
          <p>Escribe a {modelo.nombre} para concretar una cita</p>
          <a class="contact-whatsapp" href={`https://wa.me/${telefonoLimpio}`} target="_blank" rel="noreferrer" aria-label="Escr&iacute;beme por WhatsApp">
            <svg class="whatsapp-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.6 0 .3 5.3.3 11.8c0 2.1.6 4.2 1.6 6L0 24l6.3-1.7a11.8 11.8 0 0 0 5.8 1.5h.1c6.5 0 11.8-5.3 11.8-11.8 0-3.2-1.2-6.2-3.5-8.5ZM12.1 21.8a9.9 9.9 0 0 1-5-1.4l-.4-.2-3.7 1 1-3.6-.3-.4a9.9 9.9 0 1 1 8.4 4.6Zm5.5-7.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.2-.2.3-.7.9-.9 1.1-.2.2-.3.2-.6.1-.3-.1-1.2-.5-2.3-1.4-.9-.8-1.5-1.7-1.7-2-.2-.3 0-.4.1-.6l.5-.5.3-.5c.1-.2 0-.4 0-.5 0-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4s-1 1-1 2.4 1 2.8 1.2 3c.1.2 2 3.1 4.9 4.4.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.6-.1 1.7-.7 2-1.3.2-.6.2-1.1.2-1.3-.1-.2-.3-.3-.6-.4Z" />
            </svg>
            <span>Escr&iacute;beme por WhatsApp</span>
          </a>
          <a class="contact-telegram" href={`https://t.me/+${telefonoLimpio}`} target="_blank" rel="noreferrer" aria-label="Escr&iacute;beme por Telegram">
            <svg class="telegram-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M22.4 1.6 1.5 9.7c-1.4.6-1.4 1.4-.3 1.7l5.3 1.7 2 6.2c.2.7.1 1 .8 1 .5 0 .8-.2 1.1-.5l2.6-2.5 5.4 4c1 .6 1.7.3 1.9-.9l3.5-16.5c.3-1.5-.6-2.1-1.4-1.8ZM8 12.7l11-6.9c.5-.3.9-.1.6.2l-9.1 8.2-.4 4.3L8 12.7Z" />
            </svg>
            <span>Escr&iacute;beme por Telegram</span>
          </a>
        </aside>
      </div>
    </main>
  </body>
</html>

<script>
  const lightbox = document.getElementById("lightbox") as HTMLDialogElement | null;
  const lightboxImage = document.getElementById("lightbox-image") as HTMLImageElement | null;
  const lightboxCounter = document.getElementById("lightbox-counter");
  const galleryPhotos = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".portfolio-photo"),
  );
  const closeLightbox = lightbox?.querySelector(".lightbox-close");
  const previousPhoto = lightbox?.querySelector(".lightbox-previous");
  const nextPhoto = lightbox?.querySelector(".lightbox-next");
  let currentPhotoIndex = 0;
  let touchStartX: number | null = null;
  let previouslyFocusedElement: HTMLElement | null = null;

  if (
    lightbox &&
    lightboxImage &&
    lightboxCounter &&
    closeLightbox &&
    previousPhoto &&
    nextPhoto
  ) {
    const showPhoto = (index: number) => {
      currentPhotoIndex = (index + galleryPhotos.length) % galleryPhotos.length;
      const thumbnail = galleryPhotos[currentPhotoIndex].querySelector("img");

      if (!thumbnail) {
        return;
      }

      lightboxImage.src = thumbnail.currentSrc || thumbnail.src;
      lightboxImage.alt = thumbnail.alt;
      lightboxCounter.textContent = `${currentPhotoIndex + 1} / ${galleryPhotos.length}`;
    };

    galleryPhotos.forEach((photo, index) => {
      photo.addEventListener("click", () => {
        previouslyFocusedElement = photo;
        showPhoto(index);
        lightbox.showModal();
        closeLightbox.focus();
      });
    });

    closeLightbox.addEventListener("click", () => lightbox.close());
    previousPhoto.addEventListener("click", () => showPhoto(currentPhotoIndex - 1));
    nextPhoto.addEventListener("click", () => showPhoto(currentPhotoIndex + 1));

    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox) {
        lightbox.close();
      }
    });

    lightbox.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        showPhoto(currentPhotoIndex - 1);
      } else if (event.key === "ArrowRight") {
        showPhoto(currentPhotoIndex + 1);
      }
    });

    lightbox.addEventListener("close", () => {
      previouslyFocusedElement?.focus();
    });

    lightbox.addEventListener(
      "touchstart",
      (event) => {
        touchStartX = event.changedTouches[0].clientX;
      },
      { passive: true },
    );

    lightbox.addEventListener(
      "touchend",
      (event) => {
        if (touchStartX === null) {
          return;
        }

        const swipeDistance = event.changedTouches[0].clientX - touchStartX;
        touchStartX = null;

        if (Math.abs(swipeDistance) > 50) {
          showPhoto(currentPhotoIndex + (swipeDistance < 0 ? 1 : -1));
        }
      },
      { passive: true },
    );
  }
</script>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: #0a0a0a;
    color: #eee;
    font-family: "PT Sans", sans-serif;
  }

  :global(body) {
    margin: 0;
  }

  .profile {
    width: min(1200px, calc(100% - 3rem));
    margin: 0 auto;
    padding: 4rem 0 5rem;
  }

  .profile-heading {
    margin-bottom: 2rem;
    text-align: center;
  }

  .eyebrow {
    margin: 0 0 0.55rem;
    color: #d4af37;
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    font-family: Georgia, serif;
    font-weight: 400;
  }

  h1 {
    color: #fff;
    font-size: clamp(2.6rem, 7vw, 4.3rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .availability {
    display: flex;
    width: fit-content;
    justify-content: center;
    align-items: center;
    gap: 0.55rem;
    margin: 0.85rem auto 0;
    padding: 0.35rem 0.8rem;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1px solid #27ae60;
    border-radius: 999px;
    animation: pulse-availability-border 2s infinite;
  }

  .availability-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background-color: #27ae60;
    box-shadow: 0 0 10px #27ae60;
    animation: pulse-availability 2s infinite;
  }

  @keyframes pulse-availability {
    0%,
    100% {
      opacity: 1;
    }

    50% {
      opacity: 0.4;
    }
  }

  @keyframes pulse-availability-border {
    0%,
    100% {
      border-color: #27ae60;
      box-shadow: 0 0 8px rgba(39, 174, 96, 0.35);
    }

    50% {
      border-color: rgba(39, 174, 96, 0.25);
      box-shadow: 0 0 2px rgba(39, 174, 96, 0.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .availability,
    .availability-dot {
      animation: none;
    }
  }

  .subtitle {
    margin: 0.55rem 0 0;
    color: #aaa;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .subtitle span {
    padding: 0 0.4rem;
    color: #d4af37;
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: 300px;
    gap: 1rem;
  }

  .portfolio-photo {
    display: block;
    overflow: hidden;
    width: 100%;
    padding: 0;
    background: #151515;
    border: 0;
    cursor: zoom-in;
  }

  .portfolio-photo-featured {
    grid-row: span 2;
  }

  .portfolio-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 0.5s ease;
  }

  .portfolio-photo:hover img {
    transform: scale(1.035);
  }

  .lightbox {
    position: fixed;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 3.5rem 4.5rem 1.5rem;
    overflow: hidden;
    color: #fff;
    background: rgba(5, 5, 5, 0.97);
    border: 0;
  }

  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.92);
  }

  .lightbox-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    margin: 0;
  }

  .lightbox-image {
    display: block;
    max-width: 100%;
    max-height: calc(100dvh - 110px);
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }

  .lightbox-counter {
    padding-top: 0.8rem;
    color: #ccc;
    font-size: 0.9rem;
    letter-spacing: 0.1em;
  }

  .lightbox-close,
  .lightbox-nav {
    position: absolute;
    display: grid;
    place-items: center;
    color: #fff;
    background: rgba(20, 20, 20, 0.8);
    border: 1px solid rgba(212, 175, 55, 0.55);
    cursor: pointer;
  }

  .lightbox-close {
    top: 1rem;
    right: 1.2rem;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    font-size: 2rem;
    line-height: 1;
  }

  .lightbox-nav {
    top: 50%;
    width: 48px;
    height: 64px;
    border-radius: 8px;
    font-size: 3rem;
    line-height: 1;
    transform: translateY(-50%);
  }

  .lightbox-previous {
    left: 1rem;
  }

  .lightbox-next {
    right: 1rem;
  }

  .lightbox-close:hover,
  .lightbox-nav:hover {
    color: #d4af37;
    border-color: #d4af37;
  }

  .details-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.8fr);
    gap: 2rem;
    align-items: start;
    margin-top: 3rem;
  }

  .details-card {
    padding: 1.5rem 0;
    border-top: 1px solid rgba(212, 175, 55, 0.5);
  }

  .model-description {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .model-description > p:last-child {
    max-width: 720px;
    margin: 0.7rem 0 0;
    color: #bbb;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  h2 {
    color: #fff;
    font-size: 2rem;
  }

  .details-card section > .eyebrow,
  .services-section > .eyebrow {
    margin-bottom: 0.45rem;
  }

  dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 1.5rem 0 0;
  }

  dl div {
    padding: 1rem;
    background: #121212;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  dt {
    color: #999;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  dd {
    margin: 0.4rem 0 0;
    color: #eee;
    font-size: 1.05rem;
  }

  .services-section {
    margin-top: 2rem;
  }

  .service-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .service-list li {
    padding: 0.5rem 0.75rem;
    color: #ccc;
    font-size: 0.9rem;
    background: #121212;
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: 999px;
  }

  .contact-card {
    padding: 1.2rem;
    border: 1px solid #d4af37;
    border-radius: 14px;
  }

  .contact-card > p {
    margin: 0 0 0.9rem;
    color: #d4af37;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
  }

  .contact-card a {
    display: inline-flex;
    gap: 0.7rem;
    align-items: center;
    padding: 0.75rem 0;
    color: #fff;
    border: 1px solid;
    border-radius: 9px;
    padding: 0.65rem 0.85rem;
    transition: background-color 0.2s;
  }

  .contact-card a + a {
    margin-left: 0.5rem;
  }

  .contact-card .whatsapp-icon {
    width: 22px;
    height: 22px;
    fill: #25d366;
  }

  .contact-card .contact-whatsapp {
    background: rgba(37, 211, 102, 0.12);
    border-color: #25d366;
  }

  .contact-card .contact-whatsapp:hover {
    background: rgba(37, 211, 102, 0.25);
  }

  .contact-card .telegram-icon {
    width: 22px;
    height: 22px;
    fill: #229ed9;
  }

  .contact-card .contact-telegram {
    background: rgba(34, 158, 217, 0.12);
    border-color: #229ed9;
  }

  .contact-card .contact-telegram:hover {
    background: rgba(34, 158, 217, 0.25);
  }

  @media (max-width: 700px) {
    .profile {
      width: min(100% - 2rem, 1200px);
      padding-top: 3rem;
    }

    .portfolio-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 230px;
      gap: 0.65rem;
    }

    .portfolio-photo-featured {
      grid-row: span 1;
    }

    .lightbox {
      padding: 4rem 0.5rem 1rem;
      touch-action: pan-y;
    }

    .lightbox-image {
      max-width: 100%;
      max-height: calc(100dvh - 130px);
    }

    .lightbox-close {
      top: 0.6rem;
      right: 0.6rem;
    }

    .lightbox-nav {
      top: auto;
      bottom: 0.65rem;
      width: 46px;
      height: 42px;
      border-radius: 999px;
      font-size: 2rem;
      transform: none;
    }

    .lightbox-previous {
      left: calc(50% - 58px);
    }

    .lightbox-next {
      right: calc(50% - 58px);
    }

    .details-layout {
      grid-template-columns: 1fr;
      gap: 1.2rem;
      margin-top: 2rem;
    }
  }

  @media (max-width: 380px) {
    .contact-card a + a {
      margin-left: 0;
    }
  }
</style>
