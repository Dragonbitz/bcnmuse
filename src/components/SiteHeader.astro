---
import { filtros } from "../data/modelos";
---

<header class="site-header">
  <a href="/" class="site-logo">
    <img src="/logotipo/logo.png" alt="BCN Muse - Inicio" />
  </a>

  <div class="header-contacts" aria-label="Contacto directo">
    <a class="contact-whatsapp" href="https://wa.me/34652818228" target="_blank" rel="noreferrer" aria-label="Contacta por WhatsApp">
      <svg class="whatsapp-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.6 0 .3 5.3.3 11.8c0 2.1.6 4.2 1.6 6L0 24l6.3-1.7a11.8 11.8 0 0 0 5.8 1.5h.1c6.5 0 11.8-5.3 11.8-11.8 0-3.2-1.2-6.2-3.5-8.5ZM12.1 21.8a9.9 9.9 0 0 1-5-1.4l-.4-.2-3.7 1 1-3.6-.3-.4a9.9 9.9 0 1 1 8.4 4.6Zm5.5-7.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.2-.2.3-.7.9-.9 1.1-.2.2-.3.2-.6.1-.3-.1-1.2-.5-2.3-1.4-.9-.8-1.5-1.7-1.7-2-.2-.3 0-.4.1-.6l.5-.5.3-.5c.1-.2 0-.4 0-.5 0-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4s-1 1-1 2.4 1 2.8 1.2 3c.1.2 2 3.1 4.9 4.4.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.6-.1 1.7-.7 2-1.3.2-.6.2-1.1.2-1.3-.1-.2-.3-.3-.6-.4Z" />
      </svg>
      <span>Contacta</span>
    </a>
    <a class="contact-telegram" href="https://t.me/+34652818228" target="_blank" rel="noreferrer" aria-label="Contacta por Telegram">
      <svg class="telegram-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M22.4 1.6 1.5 9.7c-1.4.6-1.4 1.4-.3 1.7l5.3 1.7 2 6.2c.2.7.1 1 .8 1 .5 0 .8-.2 1.1-.5l2.6-2.5 5.4 4c1 .6 1.7.3 1.9-.9l3.5-16.5c.3-1.5-.6-2.1-1.4-1.8ZM8 12.7l11-6.9c.5-.3.9-.1.6.2l-9.1 8.2-.4 4.3L8 12.7Z" />
      </svg>
      <span>Contacta</span>
    </a>
  </div>

  <button
    class="menu-toggle"
    id="site-menu-toggle"
    type="button"
    aria-label="Abrir menú"
    aria-expanded="false"
    aria-controls="site-nav"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>

  <nav class="site-nav" id="site-nav">
    <a href="/">Inicio</a>
    <a href="/#modelos">Modelos</a>
    <a href="/#agencia">Agencia</a>
    <details class="filter-menu">
      <summary>Filtros</summary>
      <div class="filter-submenu">
        {filtros.map((filtro) => (
          <a href={`/filtros/${filtro.slug}`}>{filtro.nombre}</a>
        ))}
      </div>
    </details>
    <a href="/#contacto">Contacto</a>
  </nav>
</header>

<script>
  const menuToggle = document.getElementById("site-menu-toggle");
  const siteNav = document.getElementById("site-nav");

  if (menuToggle && siteNav) {
    menuToggle.addEventListener("click", () => {
      const isExpanded = menuToggle.getAttribute("aria-expanded") === "true";
      menuToggle.setAttribute("aria-expanded", String(!isExpanded));
      menuToggle.setAttribute("aria-label", isExpanded ? "Abrir menú" : "Cerrar menú");
      siteNav.classList.toggle("is-open");
    });

    siteNav.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) {
        siteNav.classList.remove("is-open");
        menuToggle.setAttribute("aria-expanded", "false");
        menuToggle.setAttribute("aria-label", "Abrir menú");
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 5%;
    color: #fff;
    background: rgba(10, 10, 10, 0.95);
    border-bottom: 1px solid rgba(212, 175, 55, 0.3);
    backdrop-filter: blur(10px);
  }

  .site-logo {
    display: flex;
    align-items: center;
  }

  .site-logo img {
    display: block;
    width: auto;
    height: 100px;
  }

  .header-contacts {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-left: 1.5rem;
  }

  .header-contacts a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.75rem;
    color: #fff;
    font-size: 0.82rem;
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid;
    border-radius: 9px;
    transition: background-color 0.2s, border-color 0.2s;
  }

  .header-contacts .contact-whatsapp {
    background: rgba(37, 211, 102, 0.12);
    border-color: #25d366;
  }

  .header-contacts .contact-whatsapp:hover {
    background: rgba(37, 211, 102, 0.25);
  }

  .header-contacts .contact-telegram {
    background: rgba(34, 158, 217, 0.12);
    border-color: #229ed9;
  }

  .header-contacts .contact-telegram:hover {
    background: rgba(34, 158, 217, 0.25);
  }

  .header-contacts svg {
    width: 21px;
    height: 21px;
  }

  .header-contacts .whatsapp-icon {
    fill: #25d366;
  }

  .header-contacts .telegram-icon {
    fill: #229ed9;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-left: auto;
  }

  .site-nav > a,
  .filter-menu summary {
    color: #ccc;
    font: inherit;
    font-size: 0.95rem;
    letter-spacing: 1.5px;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.3s;
  }

  .site-nav > a:hover,
  .filter-menu summary:hover,
  .filter-menu[open] summary {
    color: #d4af37;
  }

  .filter-menu {
    position: relative;
  }

  .filter-menu summary {
    cursor: pointer;
    list-style: none;
  }

  .filter-menu summary::-webkit-details-marker {
    display: none;
  }

  .filter-menu summary::after {
    display: inline-block;
    margin-left: 0.45rem;
    content: "▾";
    font-size: 0.75em;
  }

  .filter-submenu {
    position: absolute;
    top: calc(100% + 1.4rem);
    left: 50%;
    display: grid;
    grid-template-columns: repeat(2, minmax(120px, 1fr));
    gap: 0.2rem;
    width: max-content;
    max-height: min(70vh, 500px);
    padding: 0.7rem;
    overflow-y: auto;
    background: #101010;
    border: 1px solid #d4af37;
    border-radius: 12px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
    transform: translateX(-50%);
  }

  .filter-submenu a {
    padding: 0.65rem 0.75rem;
    color: #ccc;
    font-size: 0.88rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .filter-submenu a:hover {
    color: #d4af37;
    background: #1a1a1a;
    border-radius: 6px;
  }

  .menu-toggle {
    display: none;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .menu-toggle span {
    display: block;
    width: 30px;
    height: 2px;
    background: #d4af37;
  }

  .menu-toggle span + span {
    margin-top: 6px;
  }

  @media (max-width: 768px) {
    .site-header {
      display: grid;
      grid-template-columns: 1fr auto;
      padding: 0.5rem 1.5rem 0.75rem;
    }

    .site-logo img {
      height: 76px;
    }

    .header-contacts {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: center;
      gap: 1.5rem;
      margin: 0;
      padding: 0.35rem 0 0.15rem;
    }

    .header-contacts a {
      font-size: 0.78rem;
    }

    .menu-toggle {
      display: block;
    }

    .site-nav {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      max-height: calc(100vh - 80px);
      padding: 0.75rem 1.5rem 1.25rem;
      overflow-y: auto;
      background: #0a0a0a;
      border-bottom: 1px solid #d4af37;
    }

    .site-nav.is-open {
      display: flex;
    }

    .site-nav > a,
    .filter-menu summary {
      display: block;
      padding: 0.8rem 0;
      font-size: 1rem;
      text-align: center;
    }

    .filter-menu summary::after {
      content: "▾";
    }

    .filter-submenu {
      position: static;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.15rem;
      width: 100%;
      max-height: 36vh;
      padding: 0.5rem;
      border-radius: 10px;
      box-shadow: none;
      transform: none;
    }

    .filter-submenu a {
      padding: 0.65rem 0.4rem;
      font-size: 0.82rem;
      text-align: center;
      white-space: normal;
    }
  }
</style>
